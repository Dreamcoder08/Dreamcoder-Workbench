{
  "name": "Dreamcoder Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#E2E8F0",
    "activityBar.background": "#060608",
    "activityBar.foreground": "#A5B4FC",
    "activityBar.inactiveForeground": "#C0B5C0",
    "activityBar.border": "#68788F",
    "sideBar.background": "#060608",
    "sideBar.foreground": "#E2E8F0",
    "sideBar.border": "#68788F",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#E2E8F0",
    "statusBar.border": "#68788F",
    "editorGroupHeader.tabsBackground": "#060608",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#A5B4FC",
    "tab.inactiveBackground": "#060608",
    "tab.inactiveForeground": "#C0B5C0",
    "tab.border": "#68788F",
    "editor.lineHighlightBackground": "#060608",
    "editorLineNumber.foreground": "#C0B5C0",
    "editorLineNumber.activeForeground": "#A5B4FC",
    "editorWidget.background": "#0D0D11",
    "editorWidget.border": "#68788F",
    "input.background": "#0D0D11",
    "input.foreground": "#E2E8F0",
    "input.border": "#3B82F6",
    "button.background": "#C4B5FD",
    "button.foreground": "#000000",
    "list.activeSelectionBackground": "#0D0D11",
    "list.activeSelectionForeground": "#E2E8F0",
    "list.hoverBackground": "#060608",
    "editor.selectionBackground": "#0D0D11",
    "terminal.background": "#000000",
    "terminal.foreground": "#E2E8F0",
    "terminal.ansiBlack": "#060608",
    "terminal.ansiRed": "#FB8585",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#A5B4FC",
    "terminal.ansiMagenta": "#D8B4FE",
    "terminal.ansiCyan": "#7DD3FC",
    "terminal.ansiWhite": "#E2E8F0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#C0B5C0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A5B4FC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#34D399"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E2E8F0"
      }
    }
  ]
}
