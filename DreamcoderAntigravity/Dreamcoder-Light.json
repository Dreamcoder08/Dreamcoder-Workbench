{
  "name": "Dreamcoder Light",
  "type": "light",
  "colors": {
    "editor.background": "#f9f6f2",
    "editor.foreground": "#1e1814",
    "activityBar.background": "#fefdfa",
    "activityBar.foreground": "#8b440c",
    "activityBar.inactiveForeground": "#675d53",
    "activityBar.border": "#645c53",
    "sideBar.background": "#fefdfa",
    "sideBar.foreground": "#1e1814",
    "sideBar.border": "#645c53",
    "statusBar.background": "#f9f6f2",
    "statusBar.foreground": "#1e1814",
    "statusBar.border": "#645c53",
    "editorGroupHeader.tabsBackground": "#fefdfa",
    "tab.activeBackground": "#f9f6f2",
    "tab.activeForeground": "#8b440c",
    "tab.inactiveBackground": "#fefdfa",
    "tab.inactiveForeground": "#675d53",
    "tab.border": "#645c53",
    "editor.lineHighlightBackground": "#eee9e2",
    "editorLineNumber.foreground": "#675d53",
    "editorLineNumber.activeForeground": "#8b440c",
    "editorWidget.background": "#eee9e2",
    "editorWidget.border": "#645c53",
    "input.background": "#eee9e2",
    "input.foreground": "#1e1814",
    "input.border": "#006973",
    "button.background": "#a73b15",
    "button.foreground": "#fefdfa",
    "list.activeSelectionBackground": "#f1d7c2",
    "list.activeSelectionForeground": "#1e1814",
    "list.hoverBackground": "#eee9e2",
    "editor.selectionBackground": "#f1d7c2",
    "terminal.background": "#f9f6f2",
    "terminal.foreground": "#1e1814",
    "terminal.ansiBlack": "#fefdfa",
    "terminal.ansiRed": "#a12623",
    "terminal.ansiGreen": "#1c6c31",
    "terminal.ansiYellow": "#795700",
    "terminal.ansiBlue": "#8b440c",
    "terminal.ansiMagenta": "#853c70",
    "terminal.ansiCyan": "#005f8e",
    "terminal.ansiWhite": "#1e1814"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#675d53",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8b440c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#005f8e"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#1c6c31"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a73b15"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#5b4c99"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1e1814"
      }
    }
  ]
}
