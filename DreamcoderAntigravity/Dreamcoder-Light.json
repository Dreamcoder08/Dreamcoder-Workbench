{
  "name": "Dreamcoder Light",
  "type": "light",
  "colors": {
    "editor.background": "#f5ede2",
    "editor.foreground": "#1c1611",
    "activityBar.background": "#fefaf2",
    "activityBar.foreground": "#8c4d04",
    "activityBar.inactiveForeground": "#796755",
    "activityBar.border": "#695745",
    "sideBar.background": "#fefaf2",
    "sideBar.foreground": "#1c1611",
    "sideBar.border": "#695745",
    "statusBar.background": "#f5ede2",
    "statusBar.foreground": "#1c1611",
    "statusBar.border": "#695745",
    "editorGroupHeader.tabsBackground": "#fefaf2",
    "tab.activeBackground": "#f5ede2",
    "tab.activeForeground": "#8c4d04",
    "tab.inactiveBackground": "#fefaf2",
    "tab.inactiveForeground": "#796755",
    "tab.border": "#695745",
    "editor.lineHighlightBackground": "#fefaf2",
    "editorLineNumber.foreground": "#796755",
    "editorLineNumber.activeForeground": "#8c4d04",
    "editorWidget.background": "#eadcc9",
    "editorWidget.border": "#695745",
    "input.background": "#eadcc9",
    "input.foreground": "#1c1611",
    "input.border": "#00616a",
    "button.background": "#af4318",
    "button.foreground": "#fefaf2",
    "list.activeSelectionBackground": "#eadcc9",
    "list.activeSelectionForeground": "#1c1611",
    "list.hoverBackground": "#fefaf2",
    "editor.selectionBackground": "#eadcc9",
    "terminal.background": "#f5ede2",
    "terminal.foreground": "#1c1611",
    "terminal.ansiBlack": "#fefaf2",
    "terminal.ansiRed": "#902822",
    "terminal.ansiGreen": "#215d27",
    "terminal.ansiYellow": "#724800",
    "terminal.ansiBlue": "#8c4d04",
    "terminal.ansiMagenta": "#853361",
    "terminal.ansiCyan": "#08557e",
    "terminal.ansiWhite": "#1c1611"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#796755",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8c4d04",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#08557e"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#215d27"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#af4318"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#594399"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1c1611"
      }
    }
  ]
}
