{
  "name": "Dreamcoder Light",
  "type": "light",
  "colors": {
    "editor.background": "#f9f6f2",
    "editor.foreground": "#1e1813",
    "activityBar.background": "#fefdfa",
    "activityBar.foreground": "#874004",
    "activityBar.inactiveForeground": "#5f544c",
    "activityBar.border": "#5f544c",
    "sideBar.background": "#fefdfa",
    "sideBar.foreground": "#1e1813",
    "sideBar.border": "#5f544c",
    "statusBar.background": "#f9f6f2",
    "statusBar.foreground": "#1e1813",
    "statusBar.border": "#5f544c",
    "editorGroupHeader.tabsBackground": "#fefdfa",
    "tab.activeBackground": "#f9f6f2",
    "tab.activeForeground": "#874004",
    "tab.inactiveBackground": "#fefdfa",
    "tab.inactiveForeground": "#5f544c",
    "tab.border": "#5f544c",
    "editor.lineHighlightBackground": "#ede9e3",
    "editorLineNumber.foreground": "#5f544c",
    "editorLineNumber.activeForeground": "#874004",
    "editorWidget.background": "#ede9e3",
    "editorWidget.border": "#5f544c",
    "input.background": "#ede9e3",
    "input.foreground": "#1e1813",
    "input.border": "#016367",
    "button.background": "#753100",
    "button.foreground": "#fefdfa",
    "list.activeSelectionBackground": "#f1d7c1",
    "list.activeSelectionForeground": "#1e1813",
    "list.hoverBackground": "#ede9e3",
    "editor.selectionBackground": "#f1d7c1",
    "terminal.background": "#f9f6f2",
    "terminal.foreground": "#1e1813",
    "terminal.ansiBlack": "#fefdfa",
    "terminal.ansiRed": "#9c2024",
    "terminal.ansiGreen": "#1b672f",
    "terminal.ansiYellow": "#6e5201",
    "terminal.ansiBlue": "#874004",
    "terminal.ansiMagenta": "#81386b",
    "terminal.ansiCyan": "#0a5b8f",
    "terminal.ansiWhite": "#1e1813"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f544c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#874004",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#0a5b8f"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#1b672f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#753100"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#574894"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#1e1813"
      }
    }
  ]
}
