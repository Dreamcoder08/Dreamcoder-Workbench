{
  "name": "Dreamcoder Dark Night",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#c6c6c6",
    "activityBar.background": "#090909",
    "activityBar.foreground": "#a4afee",
    "activityBar.inactiveForeground": "#b3b3b3",
    "activityBar.border": "#797979",
    "sideBar.background": "#090909",
    "sideBar.foreground": "#c6c6c6",
    "sideBar.border": "#797979",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#c6c6c6",
    "statusBar.border": "#797979",
    "editorGroupHeader.tabsBackground": "#090909",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#a4afee",
    "tab.inactiveBackground": "#090909",
    "tab.inactiveForeground": "#b3b3b3",
    "tab.border": "#797979",
    "editor.lineHighlightBackground": "#090909",
    "editorLineNumber.foreground": "#b3b3b3",
    "editorLineNumber.activeForeground": "#a4afee",
    "editorWidget.background": "#0b0b0d",
    "editorWidget.border": "#797979",
    "input.background": "#0b0b0d",
    "input.foreground": "#c6c6c6",
    "input.border": "#3a76d6",
    "button.background": "#b48ce9",
    "button.foreground": "#000000",
    "list.activeSelectionBackground": "#0b0b0d",
    "list.activeSelectionForeground": "#c6c6c6",
    "list.hoverBackground": "#090909",
    "editor.selectionBackground": "#0b0b0d",
    "terminal.background": "#000000",
    "terminal.foreground": "#c6c6c6",
    "terminal.ansiBlack": "#090909",
    "terminal.ansiRed": "#e88484",
    "terminal.ansiGreen": "#43b48b",
    "terminal.ansiYellow": "#d1a126",
    "terminal.ansiBlue": "#a4afee",
    "terminal.ansiMagenta": "#b98beb",
    "terminal.ansiCyan": "#62b9e2",
    "terminal.ansiWhite": "#c6c6c6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b3b3b3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a4afee",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#62b9e2"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#43b48b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#b48ce9"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#b48ce9"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c6c6c6"
      }
    }
  ]
}
