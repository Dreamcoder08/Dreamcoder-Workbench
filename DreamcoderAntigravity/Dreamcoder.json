{
  "name": "Dreamcoder Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#ebebeb",
    "activityBar.background": "#090909",
    "activityBar.foreground": "#a7b5fd",
    "activityBar.inactiveForeground": "#cecece",
    "activityBar.border": "#777777",
    "sideBar.background": "#090909",
    "sideBar.foreground": "#ebebeb",
    "sideBar.border": "#777777",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#ebebeb",
    "statusBar.border": "#777777",
    "editorGroupHeader.tabsBackground": "#090909",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#a7b5fd",
    "tab.inactiveBackground": "#090909",
    "tab.inactiveForeground": "#cecece",
    "tab.border": "#777777",
    "editor.lineHighlightBackground": "#090909",
    "editorLineNumber.foreground": "#cecece",
    "editorLineNumber.activeForeground": "#a7b5fd",
    "editorWidget.background": "#121212",
    "editorWidget.border": "#777777",
    "input.background": "#121212",
    "input.foreground": "#ebebeb",
    "input.border": "#6eccd1",
    "button.background": "#c6d0fd",
    "button.foreground": "#000000",
    "list.activeSelectionBackground": "#121212",
    "list.activeSelectionForeground": "#ebebeb",
    "list.hoverBackground": "#090909",
    "editor.selectionBackground": "#121212",
    "terminal.background": "#000000",
    "terminal.foreground": "#ebebeb",
    "terminal.ansiBlack": "#090909",
    "terminal.ansiRed": "#fc9d95",
    "terminal.ansiGreen": "#86cf90",
    "terminal.ansiYellow": "#dcb55e",
    "terminal.ansiBlue": "#a7b5fd",
    "terminal.ansiMagenta": "#f59ac5",
    "terminal.ansiCyan": "#76c4f6",
    "terminal.ansiWhite": "#ebebeb"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#cecece",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a7b5fd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#76c4f6"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#86cf90"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c6d0fd"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#d6a2f6"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ebebeb"
      }
    }
  ]
}
