# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║              GHOSTTY — GENTLEMAN STRUCTURE + DREAMCODER SOUL                ║
# ║        Gentleman keybindings & shader · Dreamcoder themes & pulido          ║
# ║          Optimized for Neovim · Hyprland                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                   FONT                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

font-family = IosevkaTerm NF
font-family = "Symbols Nerd Font"
font-size = 14
font-feature = -calt, -liga, -dlig


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  THEME                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

# Dual-mode: auto-switches with system light/dark via theme files
theme = dreamcoder
palette-generate = true


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  CURSOR                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.96


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  WINDOW                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

window-padding-x = 20
window-padding-y = 18
window-padding-color = extend
window-padding-balance = true
window-width = 1180
window-height = 780

# Hyprland handles decorations — no redundant internal ones
window-decoration = none
window-save-state = never
window-step-resize = false

# Opacity per-mode is set in the theme files (dreamcoder-dark: 0.76, light: 0.96)
unfocused-split-opacity = 0.92
background-blur-radius = 20


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SHELL                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

command = fish --login
shell-integration = fish
shell-integration-features = no-cursor


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SCROLLBACK                                  │
# └──────────────────────────────────────────────────────────────────────────────┘

scrollback-limit = 10000


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  SHADER                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

custom-shader = shaders/cursor_smear_gentleman.glsl
custom-shader-animation = true


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                            KEYBINDINGS — TABS                                │
# └──────────────────────────────────────────────────────────────────────────────┘

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9
keybind = ctrl+0=goto_tab:10


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                          KEYBINDINGS — SPLITS                                │
# └──────────────────────────────────────────────────────────────────────────────┘

keybind = alt+v=new_split:right
keybind = alt+d=new_split:down
keybind = alt+k=goto_split:up
keybind = alt+j=goto_split:down
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = ctrl+shift+j=resize_split:up,10
keybind = ctrl+shift+k=resize_split:down,10
keybind = ctrl+shift+h=resize_split:left,10
keybind = ctrl+shift+l=resize_split:right,10


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                          KEYBINDINGS — MISC                                  │
# └──────────────────────────────────────────────────────────────────────────────┘

keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+z=jump_to_prompt:-1
keybind = ctrl+shift+x=jump_to_prompt:1
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = shift+enter=text:\x1b\r
keybind = alt+s=write_screen_file:paste


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                MOUSE / LINKS                                 │
# └──────────────────────────────────────────────────────────────────────────────┘

mouse-hide-while-typing = true
focus-follows-mouse = false
link-url = true
copy-on-select = true


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │                                  MISC                                        │
# └──────────────────────────────────────────────────────────────────────────────┘

confirm-close-surface = false
auto-update = off
