# Herdr app home: the app rewrites shipped layouts, mods, docs and state on
# every start. Track only the personal files below.
/*
!/.gitignore
!/settings.json
!/keys.json
!/programs.json
!/themes/
/themes/*
!/themes/dreamcoder-dark.json
!/themes/dreamcoder-light.json
!/themes/dreamcoder-shell-dark.json
!/themes/dreamcoder-shell-light.json
!/layouts/
/layouts/*
# Gentle Shell Desktop layout (vendored, recoloured by ./scripts/dreamcoder sync)
!/layouts/gentle-shell.json
!/mods/
/mods/*
!/mods/needs-you/
/mods/needs-you/gpui-kit.d.ts
/mods/needs-you/jsconfig.json
# Dreamcoder cockpit mods (generated .d.ts/jsconfig stay untracked)
!/mods/dc-panels/
/mods/dc-panels/gpui-kit.d.ts
/mods/dc-panels/jsconfig.json
!/mods/prs/
/mods/prs/gpui-kit.d.ts
/mods/prs/jsconfig.json
!/mods/verify/
/mods/verify/gpui-kit.d.ts
/mods/verify/jsconfig.json
!/mods/dispatch/
/mods/dispatch/gpui-kit.d.ts
/mods/dispatch/jsconfig.json
!/mods/flow/
/mods/flow/gpui-kit.d.ts
/mods/flow/jsconfig.json
!/mods/dc-status/
/mods/dc-status/gpui-kit.d.ts
/mods/dc-status/jsconfig.json
# Gentle Shell Desktop mods (vendored from Gentle Shell, MIT; tokens.js generated)
!/mods/gentle-*/
/mods/gentle-*/gpui-kit.d.ts
/mods/gentle-*/jsconfig.json
