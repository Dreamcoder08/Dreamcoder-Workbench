# Dreamcoder Dark theme for Nushell
# Auto-generated from tokens.json — do not edit manually

$env.config = {
    color_config: {
        separator: "#c5c5c5"
        leading_trailing_space_bg: "#090909"
        header: "#a7b5fd"
        date: "#e0e0e0"
        filesize: "#76c4f6"
        row_index: "#c5c5c5"
        bool: "#a7b5fd"
        nothing: "#c5c5c5"
        binary: "#e0e0e0"
        cellpath: "#e0e0e0"
        int: "#e0e0e0"
        duration: "#e0e0e0"
        range: "#e0e0e0"
        float: "#e0e0e0"
        string: "#e0e0e0"
        record: "#e0e0e0"
        list: "#e0e0e0"
        closure: "#e0e0e0"
        custom: "#e0e0e0"
    }
    completions: {
        case_sensitive: false
        quick: true
        partial: true
        algorithm: "fuzzy"
    }
    history: {
        max_size: 50000
        sync_on_enter: true
    }
   rm: { always_trash: false }
   ls: { use_ls_colors: true }
}
