# Dreamcoder Dark theme for Nushell
# Auto-generated from tokens.json — do not edit manually

$env.config = {
    color_config: {
        separator: "#cecece"
        leading_trailing_space_bg: "#090909"
        header: "#a7b5fd"
        date: "#ebebeb"
        filesize: "#76c4f6"
        row_index: "#cecece"
        bool: "#a7b5fd"
        nothing: "#cecece"
        binary: "#ebebeb"
        cellpath: "#ebebeb"
        int: "#ebebeb"
        duration: "#ebebeb"
        range: "#ebebeb"
        float: "#ebebeb"
        string: "#ebebeb"
        record: "#ebebeb"
        list: "#ebebeb"
        closure: "#ebebeb"
        custom: "#ebebeb"
    }
    completions: {
        case_sensitive: false
        quick: true
        partial: true
        algorithm: "fuzzy"
    }
    history: {
        max_size: 50000
        sync_on_enter: true
    }
   rm: { always_trash: false }
   ls: { use_ls_colors: true }
}
