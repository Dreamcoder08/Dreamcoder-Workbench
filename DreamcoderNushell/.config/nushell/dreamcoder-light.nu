# Dreamcoder Light theme for Nushell
# Auto-generated from tokens.json — do not edit manually

$env.config = {
    color_config: {
        separator: "#5f544c"
        leading_trailing_space_bg: "#f2eee9"
        header: "#874004"
        date: "#1e1813"
        filesize: "#0a5b8f"
        row_index: "#5f544c"
        bool: "#874004"
        nothing: "#5f544c"
        binary: "#1e1813"
        cellpath: "#1e1813"
        int: "#1e1813"
        duration: "#1e1813"
        range: "#1e1813"
        float: "#1e1813"
        string: "#1e1813"
        record: "#1e1813"
        list: "#1e1813"
        closure: "#1e1813"
        custom: "#1e1813"
    }
    completions: {
        case_sensitive: false
        quick: true
        partial: true
        algorithm: "fuzzy"
    }
    history: {
        max_size: 50000
        sync_on_enter: true
    }
   rm: { always_trash: false }
   ls: { use_ls_colors: true }
}
