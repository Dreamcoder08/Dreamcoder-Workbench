# ========================================================
# Dreamcoder Dark — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Dark

    # Line colors
    plus-color = "#227a5b"
    minus-color = "#904f50"
    plus-emph-color = "#34D399"
    minus-emph-color = "#FB8585"

    # Diff UI
    file-style = "#A5B4FC"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#A5B4FC"
    hunk-header-line-number-style = "#C7C7C7"
    hunk-header-color = "#868687"

    # Commit decorations
    commit-style = "#A5B4FC bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#C7C7C7"
    line-numbers-right-style = "#C7C7C7"
    line-numbers-minus-style = "#FB8585"
    line-numbers-plus-style = "#34D399"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#FBBF24"

    # Navigation
    navigate = true
