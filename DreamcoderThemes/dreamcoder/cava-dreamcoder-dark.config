# ========================================================
# Dreamcoder Dark — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#000000'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#2f4e62'
gradient_color_2 = '#477694'
gradient_color_3 = '#545a7e'
gradient_color_4 = '#757fb1'
gradient_color_5 = '#a7b5fd'
gradient_color_6 = '#c6d0fd'
gradient_color_7 = '#b06e68'
gradient_color_8 = '#fc9d95'

# Mono color (used when gradient = 0)
foreground = '#a7b5fd'
