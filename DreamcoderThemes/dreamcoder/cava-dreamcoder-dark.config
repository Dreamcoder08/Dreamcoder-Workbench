# ========================================================
# Dreamcoder Dark — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#000000'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#325465'
gradient_color_2 = '#4b7f97'
gradient_color_3 = '#525a7e'
gradient_color_4 = '#747eb0'
gradient_color_5 = '#A5B4FC'
gradient_color_6 = '#D4B5FD'
gradient_color_7 = '#b05d5d'
gradient_color_8 = '#FB8585'

# Mono color (used when gradient = 0)
foreground = '#A5B4FC'
