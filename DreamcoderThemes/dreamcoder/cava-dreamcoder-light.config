# ========================================================
# Dreamcoder Light — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#f9f6f2'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#95baca'
gradient_color_2 = '#649bb6'
gradient_color_3 = '#c29d7f'
gradient_color_4 = '#ac7951'
gradient_color_5 = '#8b440c'
gradient_color_6 = '#a73b15'
gradient_color_7 = '#bb6461'
gradient_color_8 = '#a12623'

# Mono color (used when gradient = 0)
foreground = '#8b440c'
