# ========================================================
# Dreamcoder Light — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#f5ede2'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#96b0ba'
gradient_color_2 = '#6792a6'
gradient_color_3 = '#c09d73'
gradient_color_4 = '#ac7d47'
gradient_color_5 = '#8c4d04'
gradient_color_6 = '#af4318'
gradient_color_7 = '#ae635c'
gradient_color_8 = '#902822'

# Mono color (used when gradient = 0)
foreground = '#8c4d04'
