# ========================================================
# Dreamcoder Light — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#f9f6f2'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#99b8ca'
gradient_color_2 = '#6a99b7'
gradient_color_3 = '#c09b7b'
gradient_color_4 = '#a9774b'
gradient_color_5 = '#874004'
gradient_color_6 = '#753100'
gradient_color_7 = '#b86062'
gradient_color_8 = '#9c2024'

# Mono color (used when gradient = 0)
foreground = '#874004'
