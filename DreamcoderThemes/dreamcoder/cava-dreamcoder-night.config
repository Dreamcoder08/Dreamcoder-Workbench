# ========================================================
# Dreamcoder Dark Night — Cava theme
# ========================================================
# Include from ~/.config/cava/config or place in
# ~/.config/cava/dreamcoder-cava.config.

[color]
# Background
background = '#000000'

# Gradient mode for smooth transitions
gradient = 1
gradient_count = 8

# Gradient colors (low to high frequency) — raw palette, muted at lower end
gradient_color_1 = '#274a5a'
gradient_color_2 = '#3b6f88'
gradient_color_3 = '#525877'
gradient_color_4 = '#737aa7'
gradient_color_5 = '#a4afee'
gradient_color_6 = '#b48ce9'
gradient_color_7 = '#a25c5c'
gradient_color_8 = '#e88484'

# Mono color (used when gradient = 0)
foreground = '#a4afee'
