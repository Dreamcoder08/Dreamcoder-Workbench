# ========================================================
# Dreamcoder Light — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Light

    # Line colors
    plus-color = "#d5d7c6"
    minus-color = "#e6cfc5"
    plus-emph-color = "#215d27"
    minus-emph-color = "#902822"

    # Diff UI
    file-style = "#8c4d04"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#8c4d04"
    hunk-header-line-number-style = "#3d352c"
    hunk-header-color = "#d9d1c7"

    # Commit decorations
    commit-style = "#8c4d04 bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#3d352c"
    line-numbers-right-style = "#3d352c"
    line-numbers-minus-style = "#902822"
    line-numbers-plus-style = "#215d27"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#724800"

    # Navigation
    navigate = true
