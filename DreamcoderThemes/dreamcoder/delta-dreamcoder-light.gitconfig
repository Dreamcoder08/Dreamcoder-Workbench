# ========================================================
# Dreamcoder Light — Git Delta theme
# ========================================================
# Include from ~/.config/git/config:
#   [include]
#       path = ~/.config/git/delta-dreamcoder.gitconfig

[delta]
    # Syntax highlighting theme for diff content
    syntax-theme = Dreamcoder-Light

    # Line colors
    plus-color = "#d8e1d5"
    minus-color = "#ebd6d3"
    plus-emph-color = "#1b672f"
    minus-emph-color = "#9c2024"

    # Diff UI
    file-style = "#874004"
    file-decoration-style = "bold yellow box ul"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "yellow box"
    hunk-header-file-style = "#874004"
    hunk-header-line-number-style = "#2b241e"
    hunk-header-color = "#dad6d2"

    # Commit decorations
    commit-style = "#874004 bold"
    commit-decoration-style = "bold yellow box ul"

    # Line numbers
    line-numbers = true
    line-numbers-left-style = "#2b241e"
    line-numbers-right-style = "#2b241e"
    line-numbers-minus-style = "#9c2024"
    line-numbers-plus-style = "#1b672f"

    # Side-by-side
    side-by-side = true

    # Whitespace highlighting
    whitespace-error-style = "#6e5201"

    # Navigation
    navigate = true
