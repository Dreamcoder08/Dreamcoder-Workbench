{
  "$schema": "./design-system.schema.json",
  "schema_version": 1,
  "modes": ["dark", "light", "dusk"],
  "roles": {
    "background": {
      "layer": "primitive",
      "source": "modes.{mode}.bg"
    },
    "surface": {
      "layer": "semantic",
      "source": "modes.{mode}.surface0",
      "parent": "background"
    },
    "panel": {
      "layer": "semantic",
      "source": "modes.{mode}.surface1",
      "parent": "surface"
    },
    "text": {
      "layer": "semantic",
      "source": "modes.{mode}.text",
      "parent": "background"
    },
    "muted": {
      "layer": "semantic",
      "source": "modes.{mode}.muted",
      "parent": "background"
    },
    "accent": {
      "layer": "semantic",
      "source": "modes.{mode}.accent",
      "parent": "background"
    },
    "focus": {
      "layer": "semantic",
      "source": "modes.{mode}.focus",
      "parent": "background"
    },
    "border": {
      "layer": "semantic",
      "source": "modes.{mode}.border",
      "parent": "background"
    },
    "border_hi": {
      "layer": "semantic",
      "source": "modes.{mode}.border_hi",
      "parent": "background"
    },
    "selection.background": {
      "layer": "component-state",
      "source": "modes.{mode}.selection_bg",
      "parent": "background"
    },
    "selection.text": {
      "layer": "component-state",
      "source": "modes.{mode}.selection_fg",
      "parent": "text"
    },
    "on_focus": {
      "layer": "component-state",
      "source": "modes.{mode}.on_focus",
      "parent": "focus"
    },
    "error": {
      "layer": "semantic",
      "source": "modes.{mode}.error",
      "parent": "background"
    },
    "warning": {
      "layer": "semantic",
      "source": "modes.{mode}.warning",
      "parent": "background"
    },
    "success": {
      "layer": "semantic",
      "source": "modes.{mode}.success",
      "parent": "background"
    },
    "info": {
      "layer": "semantic",
      "source": "modes.{mode}.info",
      "parent": "background"
    },
    "on_accent": {
      "layer": "component-state",
      "source": "modes.{mode}.on_accent",
      "parent": "accent"
    },
    "border_ui": {
      "layer": "semantic",
      "source": "modes.{mode}.border_ui",
      "parent": "background"
    },
    "prompt_accent": {
      "layer": "component-state",
      "source": "modes.{mode}.prompt_accent",
      "parent": "background"
    },
    "bg_soft": {
      "layer": "primitive",
      "source": "modes.{mode}.bg_soft"
    }
  },
  "targets": {
    "kitty": {
      "renderer": "kitty_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "text",
        "muted",
        "accent",
        "focus",
        "border",
        "selection.background",
        "selection.text",
        "error",
        "warning",
        "success",
        "info",
        "border_ui",
        "border_hi",
        "on_focus",
        "on_accent"
      ],
      "fields": {
        "background": "background",
        "text": "foreground",
        "muted": "inactive_tab_foreground",
        "accent": "cursor",
        "focus": "active_border_color",
        "border": "inactive_border_color",
        "selection.background": "selection_background",
        "selection.text": "selection_foreground",
        "error": "bell_border_color",
        "warning": "color3",
        "success": "color2",
        "info": "color4",
        "border_ui": "inactive_border_color",
        "border_hi": "active_border_color",
        "on_focus": "cursor_text_color",
        "on_accent": "cursor_text_color"
      },
      "mappings": {
        "focus": "accent",
        "border_hi": "accent",
        "on_focus": "on_accent",
        "border_ui": "border",
        "warning": "warning"
      }
    },
    "ghostty": {
      "renderer": "ghostty_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "text",
        "accent",
        "focus",
        "selection.background",
        "selection.text",
        "error",
        "warning",
        "success",
        "info",
        "muted",
        "on_focus",
        "on_accent"
      ],
      "fields": {
        "background": "background",
        "text": "foreground",
        "accent": "cursor-color",
        "focus": "cursor-color",
        "selection.background": "selection-background",
        "selection.text": "selection-foreground",
        "error": "palette.1",
        "warning": "palette.3",
        "success": "palette.2",
        "info": "palette.4",
        "on_focus": "cursor-text",
        "on_accent": "cursor-text"
      },
      "mappings": {
        "muted": "text",
        "focus": "accent",
        "on_focus": "on_accent",
        "warning": "warning"
      }
    },
    "warp": {
      "renderer": "warp_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "surface",
        "text",
        "accent",
        "focus",
        "error",
        "warning",
        "success",
        "info"
      ],
      "fields": {
        "background": "background",
        "surface": "background",
        "text": "foreground",
        "accent": "accent",
        "focus": "cursor",
        "error": "terminal_colors.normal.red",
        "warning": "terminal_colors.normal.yellow",
        "success": "terminal_colors.normal.green",
        "info": "terminal_colors.normal.blue"
      },
      "mappings": {
        "surface": "background",
        "focus": "accent",
        "warning": "warning"
      }
    },
    "starship": {
      "renderer": "starship_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "text",
        "muted",
        "accent",
        "focus",
        "error",
        "warning",
        "success",
        "info"
      ],
      "fields": {
        "background": "palette.bg",
        "text": "palette.text",
        "muted": "palette.muted",
        "accent": "palette.prompt_accent",
        "focus": "palette.focus",
        "error": "palette.error",
        "warning": "palette.warning",
        "success": "palette.success",
        "info": "palette.info"
      },
      "mappings": {
        "accent": "renderer:guard(prompt_accent,bg)"
      }
    },
    "tmux": {
      "renderer": "tmux_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "surface",
        "text",
        "muted",
        "accent",
        "focus",
        "error",
        "warning",
        "info",
        "success"
      ],
      "fields": {
        "background": "status-style.bg",
        "surface": "message-style.bg",
        "text": "status-left.text",
        "muted": "status-left.muted",
        "accent": "window-status-current-style",
        "focus": "pane-active-border-style",
        "error": "window-status-bell-style",
        "warning": "window-status-bell-style",
        "info": "pane-active-border-style",
        "success": "success-colour"
      },
      "mappings": {
        "warning": "error",
        "info": "focus",
        "background": "bg_soft"
      }
    },
    "opencode": {
      "renderer": "opencode_content",
      "modes": ["dark", "light", "dusk"],
      "required_roles": [
        "background",
        "panel",
        "text",
        "muted",
        "accent",
        "focus",
        "border",
        "selection.background",
        "selection.text",
        "error",
        "warning",
        "success",
        "info",
        "border_ui",
        "border_hi"
      ],
      "fields": {
        "background": "theme.background",
        "panel": "theme.backgroundPanel",
        "text": "theme.text",
        "muted": "theme.textMuted",
        "accent": "theme.accent",
        "focus": "theme.borderFocus",
        "border": "theme.border",
        "selection.background": "theme.backgroundSelected",
        "selection.text": "theme.textSelected",
        "error": "theme.error",
        "warning": "theme.warning",
        "success": "theme.success",
        "info": "theme.info",
        "border_ui": "theme.border",
        "border_hi": "theme.borderActive"
      },
      "mappings": {
        "panel": "renderer:mode-aware-panel",
        "focus": "focus",
        "border_hi": "accent",
        "border": "border_ui"
      }
    }
  },
  "matrix": [
    {
      "id": "normal-text",
      "foreground": "text",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "body-text-apca",
      "foreground": "text",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "apca",
      "threshold": "mode-aware-body",
      "severity": "error"
    },
    {
      "id": "muted-text",
      "foreground": "muted",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "starship", "tmux", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "selected-text",
      "foreground": "selection.text",
      "background": "selection.background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_terminal_selection_contrast",
      "severity": "error"
    },
    {
      "id": "focus-indicator",
      "foreground": "focus",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "wcag-non-text",
      "threshold": 3.0,
      "severity": "error"
    },
    {
      "id": "significant-border",
      "foreground": "border",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "opencode"],
      "metric": "wcag-non-text",
      "threshold": 3.0,
      "severity": "error"
    },
    {
      "id": "error-status",
      "foreground": "error",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "warning-status",
      "foreground": "warning",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "success-status",
      "foreground": "success",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "opencode", "tmux"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "info-status",
      "foreground": "info",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "muted-observation-apca",
      "foreground": "muted",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "starship", "tmux", "opencode"],
      "metric": "apca",
      "threshold": "minimum_apca_quiet",
      "severity": "warning"
    },
    {
      "id": "focus-text",
      "foreground": "on_focus",
      "background": "focus",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "significant-border-ui",
      "foreground": "border_ui",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "opencode"],
      "metric": "wcag-non-text",
      "threshold": 3.0,
      "severity": "error"
    },
    {
      "id": "significant-border-hi",
      "foreground": "border_hi",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "opencode"],
      "metric": "wcag-non-text",
      "threshold": 3.0,
      "severity": "error"
    },
    {
      "id": "status-body-apca",
      "foreground": "error",
      "background": "background",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty", "warp", "starship", "tmux", "opencode"],
      "metric": "apca",
      "threshold": "mode-aware-body",
      "severity": "error"
    },
    {
      "id": "accent-text-wcag",
      "foreground": "on_accent",
      "background": "accent",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty"],
      "metric": "wcag",
      "threshold": "minimum_text_contrast",
      "severity": "error"
    },
    {
      "id": "accent-text-apca",
      "foreground": "on_accent",
      "background": "accent",
      "modes": ["dark", "light", "dusk"],
      "targets": ["kitty", "ghostty"],
      "metric": "apca",
      "threshold": "minimum_apca_on_accent",
      "severity": "error"
    }
  ],
  "artifacts": [
    {
      "id": "dark-css",
      "owner": "scripts/generate-dark-css.py::render_css",
      "lifecycle": "checked-in",
      "source": "DreamcoderThemes/dreamcoder/tokens.json",
      "generator": "python scripts/generate-dark-css.py",
      "path": "DreamcoderThemes/dreamcoder/dreamcoder-dark.css",
      "mode_policy": "fixed:dark",
      "discovery_root": "DreamcoderThemes/dreamcoder",
      "pattern": "dreamcoder-dark.css",
      "validation": "exact-bytes"
    },
    {
      "id": "opencode-default",
      "owner": "renderers_opencode.py::opencode_content",
      "lifecycle": "workflow-specific",
      "source": "DreamcoderThemes/dreamcoder/tokens.json",
      "generator": "sync.py::sync_repo_snippets",
      "path": ".opencode/themes/dreamcoder.json",
      "mode_policy": "base-modes+derived-night",
      "discovery_root": ".opencode/themes",
      "pattern": "*.json",
      "validation": "exact-bytes"
    }
  ]
}
