/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(18, 18, 18, 0.92);
  background-alt: #090909;
  foreground: #ebebeb;
  muted: #dcdcdc;
  selected: rgba(99, 102, 241, 0.28);
  active: #a7b5fd;
  border-ui: #777777;
  focus: #6eccd1;
  urgent: #fc9d95;
  border-color: #777777;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 12px;
  border-color: #303030 #777777 #777777 #777777;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 8px;
  padding: 8px 12px;
}

listview { spacing: 4px; }

element {
  padding: 8px 12px;
  border-radius: 8px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
