/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(249, 246, 242, 0.96);
  background-alt: #fefdfa;
  foreground: #1e1814;
  muted: #352f29;
  selected: rgba(139, 68, 12, 0.30);
  active: #8b440c;
  border-ui: #645c53;
  focus: #006973;
  urgent: #a12623;
  border-color: #645c53;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
