/* Dreamcoder color layer for Rofi. */
* {
  background: rgba(245, 237, 226, 0.96);
  background-alt: #fefaf2;
  foreground: #1c1611;
  muted: #3d352c;
  selected: rgba(140, 77, 4, 0.34);
  active: #8c4d04;
  border-ui: #695745;
  focus: #00616a;
  urgent: #902822;
  border-color: #695745;
}

window {
  background-color: @background;
  border: 1px;
  border-color: @border-ui;
  border-radius: 18px;
}

entry {
  background-color: @selected;
  text-color: @foreground;
  border: 1px;
  border-color: @focus;
  border-radius: 12px;
}

element selected {
  background-color: @selected;
  text-color: @foreground;
  border: 0 0 0 3px;
  border-color: @focus;
}

element-text { text-color: @muted; }
element selected element-text { text-color: @foreground; }
