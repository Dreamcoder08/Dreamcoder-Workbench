#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${DREAMCODER_DOTS_ENV:-${0%/*}/dreamcoder-env.sh}"
# shellcheck source=/dev/null
[[ -f "${ENV_FILE}" ]] && source "${ENV_FILE}"
CMD="${1:-help}"
shift || true
# Every Python entrypoint imports dreamcoder_theme from src/; the package is
# not required to be installed, so expose it to all routes, not only CONTROL.
export PYTHONPATH="${DREAMCODER_DOTS_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
CONTROL() { python3 -m dreamcoder_theme.control "$@"; }

case "${CMD}" in
    install) exec "${DREAMCODER_DOTS_DIR}/scripts/install.sh" "$@" ;;
    repair)
        case "${1:-}" in
            catalog|plan|apply) CONTROL repair "$@" ;;
            *) exec "${DREAMCODER_DOTS_DIR}/scripts/repair.sh" "$@" ;;
        esac
        ;;
    doctor) exec "${DREAMCODER_DOTS_DIR}/scripts/doctor.sh" "$@" ;;
    doctor-json) CONTROL doctor --json "$@" ;;
    dashboard) CONTROL dashboard "$@" ;;
    tui) CONTROL tui "$@" ;;
    docs) CONTROL docs "$@" ;;
    audit) CONTROL audit "$@" ;;
    control) CONTROL "$@" ;;
    settings) CONTROL settings "$@" ;;
    profile) CONTROL profile "$@" ;;
    motion) CONTROL motion "$@" ;;
    backup) CONTROL backup "$@" ;;
    visual) CONTROL visual "$@" ;;
    installer) CONTROL installer "$@" ;;
    status) exec "${DREAMCODER_DOTS_DIR}/scripts/status.sh" "$@" ;;
    verify) exec "${DREAMCODER_DOTS_DIR}/scripts/verify.sh" "$@" ;;
    upstream-diff) exec "${DREAMCODER_DOTS_DIR}/scripts/upstream-diff.py" "$@" ;;
    preview) exec "${DREAMCODER_DOTS_DIR}/scripts/generate-theme-preview.py" "$@" ;;
    auto) exec "${DREAMCODER_DOTS_DIR}/scripts/theme-auto.sh" "$@" ;;
    # Phase 5 (R7): light/dark/night route through the control activation
    # path (prepare -> validate -> persist -> commit -> reload adapter); the
    # generic settings interface continues to serve theme.render_profile.
    light|dark|night) CONTROL theme apply "${CMD}" "$@" ;;
    theme) CONTROL theme "$@" ;;
    sync) exec "${DREAMCODER_DOTS_DIR}/scripts/sync-dreamcoder-theme.py" "$@" ;;
    *)
        printf 'Usage: dreamcoder {install|repair|doctor|doctor-json|dashboard|tui|docs|audit|control|settings|profile|motion|backup|visual|installer|status|verify|upstream-diff|preview|auto|light|dark|night|theme|sync}\n' >&2
        exit 2
        ;;
esac
